/CMakeCache.txt
/compile_commands.json
/config.env

# Local diagnostic logs are archived separately from source.
/archive/diagnostics/*.log
/logs/

# Local backups of credentials; never commit.
.secrets-backup/

# Dane lokalne i eksporty diagnostyczne pozostaja na komputerze.
