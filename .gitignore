/.github-upload/
/archive/diagnostics/first-event-*/
/firmware/archive/source-bundles/
/automatic-events-start-*.txt
/can-*.csv
/can-*.txt
/capture-*.csv
/car-*.txt
/drive-*.csv
/event-TEST-*.csv
/event-status-*.txt
/ota-followup-*.txt
