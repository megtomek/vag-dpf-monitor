# Nie zapisuj sekretow Wi-Fi ani lokalnych artefaktow kompilacji w repozytorium.
secrets.yaml
# Skróty Windows wskazują lokalne ścieżki i nie przenoszą się na inne komputery.
*.lnk
.esphome/
.esphome-data/
.esphome-idf/
.venv/
build/
*.bin
*.elf
*.py[cod]
__pycache__/

